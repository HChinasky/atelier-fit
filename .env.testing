# Test environment configuration.
#
# Laravel loads THIS file (instead of .env) whenever APP_ENV=testing, which
# phpunit.xml sets for the whole suite. It contains NO real secrets: the DB
# and Redis credentials are the local Docker (Sail) defaults. In CI the same
# keys are provided as real environment variables (Postgres/Redis services),
# which take precedence over this file — so the suite runs unchanged locally
# and in CI, differing only by env values, with no code/config edits.

APP_NAME="AI Fitting Room"
APP_ENV=testing
APP_KEY=base64:00qs3wI2i2MSVoENVm7P5c46xfiQyLoXFxan19r3Qp0=
APP_DEBUG=true
APP_URL=http://localhost

# --- Test isolation: never touch external services (CLAUDE.md) ---
# Queue runs inline (sync), cache/session live in memory (array). These keep
# the suite independent of Redis-queue / cache backends. Do NOT switch these
# to redis/database.
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
BROADCAST_CONNECTION=null

# --- Dedicated Postgres test database ---
# Same engine as production (pgsql, NOT sqlite) so tests catch Postgres
# specifics (JSONB, upsert, partial indexes). A SEPARATE database ("testing")
# so runs never share or corrupt the dev database.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=testing
DB_USERNAME=sail
DB_PASSWORD=password
DB_SSLMODE=prefer

# --- Redis connection params ---
# No queue/cache traffic flows through Redis in tests (see array/sync above);
# these only support the /health liveness probe's direct connectivity check.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

BCRYPT_ROUNDS=4
