# Pose-detection microservice configuration.
# Copy to .env for local development:  cp .env.example .env
# No secrets are committed; fill values locally.

# --- Network ---
# Bind address. Keep 127.0.0.1 locally so the service is NOT publicly reachable.
POSE_SERVICE_HOST=127.0.0.1
POSE_SERVICE_PORT=8000

# --- Auth ---
# Shared secret the backend must send as the `X-API-Token` header.
# Leave EMPTY for localhost-only dev (auth disabled). On a server, set a long
# random value AND restrict network access (firewall/bind). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSE_API_TOKEN=

# --- Model ---
# Path to the .task model (relative to the service root or absolute).
POSE_MODEL_PATH=models/pose_landmarker_full.task

# Max people to detect. >1 enables person_count > 1.
POSE_MAX_PERSONS=6
POSE_MIN_DETECTION_CONFIDENCE=0.5
POSE_MIN_PRESENCE_CONFIDENCE=0.5

# Landmarks below this confidence are excluded from the bounding box, so points
# MediaPipe extrapolates off-frame (e.g. legs of a waist-up photo) don't inflate
# it. They are still returned in `landmarks` with their true low confidence.
POSE_BBOX_MIN_CONFIDENCE=0.5

# Reject uploads larger than this many bytes before decoding (15 MiB default).
POSE_MAX_UPLOAD_BYTES=15728640

# --- Image enhancement (/preprocess-image): lighting + segmentation ---
# This endpoint enhances the input (person) photo. The backend decides WHICH
# steps to run (PREPROCESS_LIGHTING / PREPROCESS_SEGMENT on the Laravel side);
# the params below tune HOW they run.
#
# rembg segmentation memory: on a GPU-less / low-RAM box keep SEGMENT_KEEP_LOADED
# false so the model is released after each call (MediaPipe is already resident).
# Set true only if a memory check shows headroom and the reload latency hurts.
SEGMENT_KEEP_LOADED=false
# rembg model: u2net (quality, default) | u2netp (light, ~5MB) | isnet-general-use.
SEGMENT_MODEL=u2net
# Override where rembg caches its model (defaults to ~/.u2net). Useful so a
# systemd service with a locked-down HOME still finds the pre-downloaded model.
# U2NET_HOME=/var/www/fitting-room/pose-service/models/rembg

# Solid neutral studio background for the cut-out person (#rrggbb or r,g,b).
# Never transparent — the VTON engine receives opaque pixels.
PREPROCESS_BG_COLOR=#f0f0f0

# Lighting normalization (classical CV). CLAHE clip/tile control local-contrast
# strength; gray-world white balance and gamma-to-target lift dark / tame bright
# photos. GAMMA_TARGET is the mid luminance to aim for (0..1).
PREPROCESS_CLAHE_CLIP=2.0
PREPROCESS_CLAHE_TILE=8
PREPROCESS_WHITE_BALANCE=true
PREPROCESS_GAMMA=true
PREPROCESS_GAMMA_TARGET=0.5

# Re-encode quality for lossy output formats (jpeg/webp), 1–100.
PREPROCESS_OUTPUT_QUALITY=90

# --- seasonal colour analysis (/color-analysis) ------------------------------
# An OPTIONAL extra. This service exists to detect poses, and a deployment that
# only wants that installs neither the color-engine package nor its models. Off
# by default: /pose, /preprocess-image and /health do not depend on it in any
# way, and while it is off /color-analysis answers 503 with the reason.
COLOR_ENGINE_ENABLED=false

# Where the color-engine MediaPipe artifacts live (face_landmarker.task and
# selfie_multiclass_256x256.tflite). Leave empty and the library falls back to
# its own default, services/color-engine/models — which only exists when the
# package is installed editable from a source checkout, so a NON-EDITABLE
# production install has to set this. Missing models do NOT stop the service:
# it starts, logs a warning, and /color-analysis answers 503 with the reason.
COLOR_ENGINE_MODELS_DIR=

# Master switch for the engine's white balance.
#
# DEVELOPMENT: set this to true. The admin colour-analysis page exists to judge
# what the engine does, and with the correction off it shows measurements of
# whatever light the photo was taken in - which is honest but not what you are
# trying to look at. The page labels every uncalibrated result as such.
#
# PRODUCTION: leave it false, deliberately: the
# sclera's target chromaticity has never been measured on a real reference set,
# so the correction pulls it to exact neutral — which a healthy sclera is not —
# and biases every result cool. Off reports the samples exactly as measured and
# lowers the confidence. Turn it on only to evaluate the correction.
# See services/color-engine/README.md, "Before this ships".
COLOR_ENGINE_WHITE_BALANCE_ENABLED=false
