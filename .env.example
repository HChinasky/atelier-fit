# Technical application name. It is NOT the visible brand (that stays "the stylist
# Fit" in the templates) — it only feeds infrastructure names: the session
# cookie, and the cache/redis key prefixes. Keep it neutral: the session cookie
# name is visible to every visitor in their browser, and a personal name there
# discloses who runs the site to anyone who opens dev tools.
# Changing it renames the session cookie, so everyone is signed out once.
APP_NAME="Atelier Fit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Interface language for a visitor whose browser asks for none of the
# supported ones (config/locales.php: uk, en). A choice made on the switcher
# or with ?lang= always wins. FALLBACK fills a key a language lacks.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL ---
# In Sail, DB_HOST is the service name "pgsql"; for host-direct runs use 127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=fitting_room
DB_USERNAME=sail
DB_PASSWORD=
# Managed Postgres (prod) usually needs TLS. Common values: prefer | require | verify-full
DB_SSLMODE=prefer

# --- Sessions / Cache / Queue: all backed by Redis (not database, not sync) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# --- Redis ---
# Use the pure-PHP "predis" client so the phpredis C extension is not required.
REDIS_CLIENT=predis
REDIS_HOST=redis
# Managed Redis with ACLs needs a username; leave null for a default instance.
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Horizon ---
# Redis key prefix isolating this app's Horizon data.
HORIZON_PREFIX=fitting_room_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cloudflare R2 (S3-compatible object storage for photos / results) ---
# Endpoint looks like https://<accountid>.r2.cloudflarestorage.com
# Region is always "auto" for R2; path-style addressing is required.
# Never commit real keys — fill these only in the local .env.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

# --- Product feed import (ImportFeedJob) ---
# Source of the partner product feed. FEED_AUTH_TOKEN only if the feed is
# protected. FEED_BRANDS is the allow-list of brands let into the catalog.
# FEED_FORMAT selects the parser; leave it EMPTY for the safe no-op default
# (NullFeedParser, imports nothing), set it to 'xml' for the Google Merchant
# RSS parser or 'amazon' for the Amazon Product Advertising API shape.
# FEED_CURRENCY is the only accepted price currency — products priced in
# anything else are skipped. FEED_BRANDS="*" lets every brand through.
# The file importer (php artisan catalog:import-file) reads the shape from the
# file itself and ignores FEED_FORMAT; its --amazon option publishes the
# Amazon.ae catalog shipped in git and lifts the allow-list for that run.
FEED_URL=
FEED_FORMAT=
FEED_CURRENCY=AED
FEED_TIMEOUT=30
FEED_AUTH_TOKEN=
FEED_BRANDS="Zara,Mango,Massimo Dutti,H&M,Bouguessa,Modanisa,OneByOne,Zimmermann"
# Brand written for an Amazon listing that carries none (Amazon's own word for
# unbranded goods). Empty = skip such listings instead.
FEED_AMAZON_FALLBACK_BRAND=Generic

# --- Catalog API (GET /api/catalog) ---
# CATALOG_PER_PAGE is the default page size. CATALOG_SHOW_UNVERIFIED is a DEV-ONLY
# switch: when true AND the app is not in production, the catalog also returns
# unverified products (so the front-end has data while the verifier is a stub).
# It is force-ignored in production — leave it false outside local development.
# To publish specific products for real (any environment), verify their photos
# by hand instead: php artisan catalog:verify <external_id> ...
CATALOG_PER_PAGE=24
CATALOG_SHOW_UNVERIFIED=false
# true (default): the catalog shows only Amazon.ae items; the other sources stay
# in the database, switched off. false brings them back.
CATALOG_AMAZON_ONLY=true

# --- Pose detection microservice (Phase 9, self-hosted CPU) ---
# Internal service for input-photo preprocessing. Reached by direct multipart
# upload (never a public URL). POSE_DRIVER=null uses the no-op stub for envs
# without the service. POSE_API_TOKEN is optional (empty = no auth); keep any
# real value only in your local .env. From the Laravel container the default
# URL targets the host (see pose-service/README.md). POSE_FAILURE_MODE chooses
# degradation when the service is down: fail_open (default) or fail_closed.
POSE_DRIVER=mediapipe
POSE_SERVICE_URL=http://host.docker.internal:8000
POSE_API_TOKEN=
POSE_HTTP_TIMEOUT=15
POSE_FAILURE_MODE=fail_open

# --- Photo suitability gate (Phase 9.2, pose-based go/no-go) ---
# Thresholds for the input-photo validator (config/photo.php). PHOTO_LANDMARK_MIN_
# CONFIDENCE is the minimum landmark confidence to treat a point as reliably seen
# (also gates "full height" via ankle confidence). PHOTO_MIN_SHOULDER_SEPARATION is
# the minimum horizontal shoulder separation as a fraction of image width below
# which a pose reads as profile/edge-on rather than frontal.
PHOTO_LANDMARK_MIN_CONFIDENCE=0.5
PHOTO_MIN_SHOULDER_SEPARATION=0.05

# --- Photo geometry normalization (Phase 9.3, applied before FASHN) ---
# Pure geometry: EXIF orientation fix, downscale-only size cap, re-encode. No ML,
# no cropping. PHOTO_IMAGE_DRIVER is the backend ('gd' default, always present, or
# 'imagick'). PHOTO_MAX_DIMENSION caps the longest side in pixels (larger photos
# scale DOWN preserving aspect ratio; smaller ones are untouched). PHOTO_TARGET_
# FORMAT is the output encoding ('jpeg' | 'png' | 'webp'). PHOTO_IMAGE_QUALITY is
# 1–100 for lossy formats.
PHOTO_IMAGE_DRIVER=gd
PHOTO_MAX_DIMENSION=2000
PHOTO_TARGET_FORMAT=jpeg
PHOTO_IMAGE_QUALITY=90

# --- Photo person-aware cropping (Phase 9.4, applied before FASHN) ---
# Crops the normalized photo around the person using reliable pose landmarks (no
# ML, no distortion). PHOTO_CROP_MIN_CONFIDENCE is the minimum landmark confidence
# for a point to anchor the crop box (off-frame / low-confidence points are
# ignored so they cannot stretch the crop). PHOTO_CROP_PAD_* are the margins added
# around the detected body before cropping: CROWN is the upward head allowance as a
# fraction of the face->shoulder span (MediaPipe has no crown point, so the top edge
# must reach above the face to keep the head whole); SIDE as a fraction of body
# width; TOP (a floor the crown allowance may exceed) and BOTTOM as fractions of
# body height. Output format reuses the PHOTO_* (9.3) settings above.
PHOTO_CROP_MIN_CONFIDENCE=0.5
PHOTO_CROP_PAD_CROWN=1.1
PHOTO_CROP_PAD_TOP=0.08
PHOTO_CROP_PAD_BOTTOM=0.05
PHOTO_CROP_PAD_SIDE=0.5

# --- Photo output aspect fit (Phase 9.6, applied after cropping) ---
# Fits the cropped photo to the aspect the VTON engine generates so the
# Before/After slider shares one frame (no letterbox bars). Widens the person's
# region with the photo's REAL margins, padding neutral only where the photo runs
# out (never crops the person). PHOTO_OUTPUT_ASPECT is 'W:H' / 'W/H' / decimal;
# empty disables the step. Default 3:4 = the engine output ratio. PAD_COLOR is the
# neutral fill used only for the rare pad fallback.
PHOTO_OUTPUT_ASPECT=3:4
PHOTO_OUTPUT_PAD_COLOR=#f0f0f0

# --- Photo appearance enhancement (Phase 9.5, applied before FASHN) ---
# Lighting normalization and person segmentation onto a neutral background, run
# by the pose microservice (POST /preprocess-image) AFTER validation and BEFORE
# cropping. Each step is an independent on/off flag so either can be rolled back
# in one line. Defaults: lighting ON, segmentation OFF (background neutralization
# is not needed yet — set PREPROCESS_SEGMENT=true to enable). A failure is
# fail-open (the unenhanced photo proceeds — generation never blocks). The HOW
# (rembg model, neutral colour, CLAHE/white-balance/gamma) is configured on the
# pose service itself (see pose-service/.env.example). PREPROCESS_HTTP_TIMEOUT is
# longer than POSE_HTTP_TIMEOUT because rembg adds a few CPU seconds.
PREPROCESS_LIGHTING=true
PREPROCESS_SEGMENT=false
PREPROCESS_HTTP_TIMEOUT=30

# --- Virtual Try-On engine selector ---
# Which VTON provider the job uses: 'fashn' (the canonical engine, production
# default — see CLAUDE.md hard constraint #1) or 'fal' (kept as a fallback).
# Same contract/job for both.
TRYON_DRIVER=fashn

# --- fal.ai Try-On API (VTON engine — production default) ---
# Real key lives only in your local .env — never commit it. Sent as the
# "Authorization: Key <FAL_KEY>" header. Async queue protocol, polling (no webhook).
FAL_KEY=
FAL_BASE_URL=https://queue.fal.run
FAL_TRYON_MODEL=fal-ai/image-apps-v2/virtual-try-on
# Queue status/result address the APP id (model's first two path segments). Leave
# empty to derive it from the model; set only if fal changes that convention.
FAL_TRYON_APP_ID=
FAL_HTTP_TIMEOUT=30
# Keep the person's pose between the source photo and the result (reduces pose
# drift and aligns the Before/After slider). Sent explicitly; default true.
FAL_PRESERVE_POSE=true
# Output aspect ratio. Empty = fal's default (3:4 for fashion). Force one of the
# model's allowed values to override: 1:1 | 16:9 | 9:16 | 4:3 | 3:4.
FAL_ASPECT_RATIO=

# --- FASHN Try-On API (canonical VTON engine) ---
# Real key lives only in your local .env — never commit it.
FASHN_API_KEY=
# Default model is tryon-max. Its inputs are model_image + product_image +
# generation_mode; it auto-detects garment category and returns ONE image.
FASHN_MODEL_NAME=tryon-max
# Quality lever sent as tryon-max's generation_mode. 'quality' = best output
# (skin/garment fidelity, helps hard cases like long dresses); same credit cost.
FASHN_MODE=quality
# Looks per generation. tryon-max returns ONE image per call (no num_samples
# input), so 1 = one look, cost 1 credit. Drives the budget cost; clamped 1–4.
FASHN_NUM_SAMPLES=1
# Output format for the background-change step (Phase 5). tryon-max itself takes no
# output_format input.
FASHN_OUTPUT_FORMAT=png
# ⚠ DELIBERATE OWNER DECISION: 'permissive' ALLOWS lingerie/swimwear/revealing
# garments. The culturally safe UAE default would be 'conservative' (blocks that).
# The owner has consciously chosen permissive. Flip back in one line if needed.
FASHN_MODERATION_LEVEL=permissive

# --- FASHN Background Change (Phase 5, optional) ---
# Off by default. When on, EACH look gets an extra background-change run: +1
# credit per look (4 looks + background = 8 credits per generation). Format
# confirmed by a live FASHN call (model_name=background-change, inputs={image,
# prompt}, output=[url]); still best-effort since FASHN's model lifecycle is
# experimental — a failed step leaves the look on its try-on background.
# Prompts are pipe-separated (a prompt itself contains commas).
FASHN_BACKGROUND_ENABLED=false
FASHN_BACKGROUND_MODEL_NAME=background-change
FASHN_BACKGROUND_PROMPTS=Dubai Marina, street style

# --- Outfit chaining (try on a SET of garments in sequence) ---
# An outfit is a CHAIN of single try-on calls (result N -> person image N+1).
# OUTFIT_MAX_ITEMS caps the set size (start: 2; raise to allow bigger sets).
# Outfit jobs run on their OWN queue/connection so a long chain never shares the
# single-try-on worker timeout. OUTFIT_JOB_TIMEOUT is the max seconds a chain may
# run (sized with headroom for several layers); OUTFIT_QUEUE_RETRY_AFTER MUST stay
# greater than it so a still-running chain is never re-dispatched (double spend).
OUTFIT_MAX_ITEMS=2
OUTFIT_QUEUE=outfits
OUTFIT_QUEUE_CONNECTION=redis_outfits
OUTFIT_JOB_TIMEOUT=1200
OUTFIT_QUEUE_RETRY_AFTER=1500

# --- Generation budget protection ---
# per-user/day flood guard (IP+contact), global hard cap, and the cap's window in
# seconds. The lead gate (no lead → no generation) is the primary protection; the
# global cap is the real safety valve against runaways. NOTE: the cap counts FASHN
# CREDITS, not generations — one generation costs num_samples × (background ? 2:1).
GENERATION_PER_USER_DAILY_LIMIT=3
GENERATION_GLOBAL_CAP=200
GENERATION_GLOBAL_CAP_PERIOD=86400

# --- Sign-in: e-mail code, Google, Apple ---
# Passwordless. A six-digit code goes out by e-mail through MAIL_MAILER (see
# the MAIL_* block above: 'log' locally writes the code to laravel.log; in
# production use Resend's SMTP relay — MAIL_MAILER=smtp, MAIL_HOST=smtp.resend.com,
# MAIL_PORT=465, MAIL_SCHEME=smtps, MAIL_USERNAME=resend, MAIL_PASSWORD=<API key>,
# MAIL_FROM_ADDRESS on a domain verified in Resend).
#
# Google: an OAuth 2.0 Web client in Google Cloud Console, with
# <APP_URL>/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: from the client's Apple Developer account — a Services ID (the client
# id) with Sign in with Apple enabled and <APP_URL>/auth/apple/callback as a
# return URL, the Team ID, and a Sign in with Apple key (Key ID + the .p8
# file; APPLE_PRIVATE_KEY is the absolute path to that file on the server).
# APPLE_CLIENT_SECRET stays empty: it is generated from the key per request.
# Either provider's button appears only when its client id is set.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# OTP_TEST_ADDRESSES / OTP_TEST_CODE — demo and QA access that does not depend
# on a working mailer: for these addresses NO message is sent and OTP_TEST_CODE
# is accepted as the code. Both must be set or the bypass stays off, and the
# code must be exactly six digits, so a stray value cannot half-enable it.
# Nobody has to OWN a listed address to use it, so the code is the only thing
# guarding those accounts — keep it random and secret.
OTP_TEST_ADDRESSES=
OTP_TEST_CODE=

# --- Sign-in: WhatsApp code (Meta WhatsApp Cloud API, no Twilio) ---
# From Meta for Developers → the app → WhatsApp → API Setup.
# WHATSAPP_TOKEN must be a PERMANENT System User token (Business Settings →
# System users) with whatsapp_business_messaging + whatsapp_business_management;
# the token shown on the API Setup page expires within ~24 hours.
# WHATSAPP_AUTH_TEMPLATE — name of the approved AUTHENTICATION-category template.
# WHATSAPP_APP_SECRET signs the delivery-status webhook (X-Hub-Signature-256);
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is the string Meta echoes on webhook setup.
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_AUTH_TEMPLATE=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Like OTP_TEST_ADDRESSES, for phone numbers in E.164 (+971...), comma-separated.
OTP_TEST_PHONES=
# The country the phone picker opens on and that a number typed without
# a country code is read in. OTP_ALLOWED_REGIONS narrows sign-in to a list
# of ISO codes (AE,SA); empty = every country's mobile.
OTP_DEFAULT_REGION=AE
OTP_ALLOWED_REGIONS=

# --- Cloudflare Turnstile (bot gate before sign-in codes are sent) ---
# Server-side token check before every code is sent. Leave the secret empty to
# disable; the check is also always off in the 'local' environment. When
# enabled it fails closed (no valid token → no code).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Membership funnel & credits (Stage B3, active only with FEATURE_MEMBERSHIP) ---
# The "2+4" funnel: guests get MEMBERSHIP_GUEST_FREE_GENERATIONS try-ons per
# contact (lifetime; failed ones do not count), then must sign in.
# First-ever verification of an e-mail grants MEMBERSHIP_WELCOME_CREDITS — once
# per address EVER, surviving account deletion (welcome_grants).
MEMBERSHIP_WELCOME_CREDITS=4
# Whether /pricing prices include VAT (true/false). Decided 2026-11-19: prices include VAT.
# Empty = undecided, and the page then says nothing about VAT.
MEMBERSHIP_PRICES_INCLUDE_VAT=true
# Version of the published Terms of Use; raising it asks everyone to accept again.
TERMS_VERSION=2
MEMBERSHIP_GUEST_FREE_GENERATIONS=2
# Where the account dashboard's "book a consultation with our stylist" buttons lead
# (a booking page or a wa.me link). Empty → those buttons render inert.
STYLIST_BOOKING_URL=
# The main site, where the coming-soon page's "Back to Atelier Fit" leads.
SITE_HOME_URL=https://atelierfit.example

# --- Data retention (config/privacy.php, enforced by app:cleanup-expired-data) ---
# These are PUBLISHED PROMISES: the same periods appear in the privacy policy.
# Change a value here and the document
# has to change with it. They are env-driven because they are lawyer-proposed
# defaults, expected to be adjusted after legal review without a code change.
# A value of 0 DISABLES that rule (a mistyped env keeps data rather than deleting
# it); the command reports every disabled rule on each run.
# NOT covered, on purpose: the irreversible phone hash in welcome_grants, which is
# permanent so a welcome bonus cannot be claimed twice. The policy discloses this.
LEAD_RETENTION_MONTHS=12
ACCOUNT_INACTIVITY_MONTHS=24
LOG_RETENTION_DAYS=90
CONSENT_RECORD_YEARS=3

# --- Photo-processing consent (config/consent.php) ---
# CONSENT_VERSION pins the wording in force. Consent is recorded per version and a
# record made against an older version stops authorising new processing — so BUMP
# this whenever the consent text, the AI provider or the retention period changes
# materially. The current wording is a DRAFT awaiting legal review.
# The link variables are empty until the reviewed documents are actually
# published; while empty, the interface renders no link rather than a dead one.
CONSENT_VERSION=2
# CONSENT_REQUIRED shows the photo-consent and Terms boxes (try-on, colour
# analysis, onboarding selfie, internal fitting room) and makes the endpoints
# require them. Off by default (owner's decision 2026-10-13): no boxes, and no
# consent records are written.
CONSENT_REQUIRED=false
# --- Published legal documents (config/legal.php) ---
# Where the legal pages are served from: this application's own /legal path
# (docs/legal/*.md rendered as HTML). Change it only if the documents move.
LEGAL_BASE_URL=https://demo.atelierfit.example/legal

CONSENT_PRIVACY_URL=https://demo.atelierfit.example/legal/privacy-policy
CONSENT_AI_DISCLOSURE_URL=https://demo.atelierfit.example/legal/ai-disclosure

# --- Server-side product analytics (config/analytics.php, PostHog EU) ---
# OFF by default. Enable in production ONLY after the legal documents that
# describe this processing are published (Privacy Policy §3.6/§5, Cookie Policy
# §5) — the documents change first, the switch second. Events are sent from the
# SERVER over a queue; no analytics JS/cookie ever loads on a page.
ANALYTICS_ENABLED=false
POSTHOG_HOST=https://eu.i.posthog.com
# Project API key (phc_…) for event capture.
POSTHOG_KEY=
# Personal API key + numeric project id — used ONLY by app:delete-user-data to
# erase a person from PostHog. Leave empty to skip that step.
POSTHOG_PERSONAL_KEY=
POSTHOG_PROJECT_ID=
# Comma-separated IPs whose events are stamped is_internal=true (team traffic).
ANALYTICS_INTERNAL_IPS=
# Cookie name that marks a team browser as internal (set by hand in dev tools).
ANALYTICS_INTERNAL_COOKIE=oys_internal
# USD per engine credit, feeds generation_completed.cost_usd. Empty = omitted.
ANALYTICS_COST_PER_CREDIT_USD=
# Deployed revision (git sha) stamped on every event; set by the deploy script.
APP_VERSION=

# --- Branded share cards (config/share.php) ---
# Composed after a successful generation (feed 3:4 + story 9:16), stored in the
# SAME private R2 prefix as the result (same 72h purge), served only via signed
# URLs ≤ SHARE_SIGNED_URL_MINUTES. Real logo/font land in resources/share/
# (SHARE_LOGO_PATH / SHARE_FONT_PATH override the default locations).
SHARE_CARDS_ENABLED=true
SHARE_SIGNED_URL_MINUTES=30

# --- Feature flags ---
# Membership & Account area (Stage A: UI only — /pricing and /account/* with
# mock data). While false, all membership routes 404.
FEATURE_MEMBERSHIP=false

# Pre-launch curtain. With membership on, an e-mail typed into the sign-in
# field is KEPT as a waiting-list lead (leads.tags = ["waitlist"]) and the
# visitor is sent to /coming-soon instead of getting a code — no account, no
# message, until we open. Addresses in OTP_TEST_ADDRESSES bypass it and sign in
# as usual. Retention and erasure are the ordinary lead rules (12 months, user:erase).
FEATURE_COMING_SOON=false

# The try-on surface: the /ai-fitting-room page and the endpoints that feed it
# (catalog, lead, photo upload, generate). It is an INTERNAL testing page, not
# a client-facing one — keep it false in production and switch it on only for
# a test session. While false every one of those routes is a plain 404.
FEATURE_FITTING_ROOM=false

# --- Laravel Sail port forwarding to host ---
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
APP_PORT=80

VITE_APP_NAME="${APP_NAME}"

# --- Colour analysis ---------------------------------------------------------
# The colour engine's surfaces: the /admin/color instrument (admin-only on top
# of the flag), the /stylist/color labelling queue, and the member's own
# /account/color page — a face photo in, a season and a palette out, only
# after an explicit consent tick (recorded on the row) and never with the
# measurements the instrument shows. OFF by default. The privacy policy names
# the analysis (section 3.8); turn this on only with that text published.
COLOR_ANALYSIS_ENABLED=false

# How long the MEASUREMENTS live. The photo and the rendered views are gone in
# hours (PHOTO_HARD_DELETE_HOURS); this is the CIELAB numbers left behind, which
# are not a picture but are still measurements of somebody's body kept against a
# user id. Open question: 90 days is an engineering placeholder; see the
# reasoning in config/privacy.php. 0 disables the rule (keeps data).
COLOR_PROFILE_RETENTION_DAYS=90

# Its own queue and worker, so an admin poking at the engine can never tie up
# the try-on workers.
#
# Three timeouts govern one analysis and their ORDER is what matters:
#   POSE_COLOR_TIMEOUT (60) < COLOR_JOB_TIMEOUT (120) < COLOR_QUEUE_RETRY_AFTER (180)
# The socket gives up first, so the job catches a transport error and records a
# failure somebody can read; the worker timeout comes next so it is never killed
# mid-call; retry_after comes last so a job that is still running is never handed
# to a second worker, which would analyse one photo twice and race to write the
# same row. ColorAnalysisTimeoutsTest pins that ordering.
COLOR_QUEUE=color
COLOR_QUEUE_CONNECTION=redis_color
COLOR_QUEUE_RETRY_AFTER=180
COLOR_JOB_TIMEOUT=120

# HTTP timeout for pose-service POST /color-analysis. Several times
# POSE_HTTP_TIMEOUT, because the call runs two MediaPipe model sets over the
# photo and may load them first.
POSE_COLOR_TIMEOUT=60
